{
  "name": "decktap",
  "version": "1.0.4",
  "description": "📡 DeckTap is a lightweight local-network remote for controlling presentations.   Use your phone to wirelessly control PowerPoint, Keynote, PDF slideshows — no app installation needed.",
  "homepage": "https://github.com/Rico00121/decktap#readme",
  "bugs": {
    "url": "https://github.com/Rico00121/decktap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rico00121/decktap.git"
  },
  "author": "Rico",
  "type": "commonjs",
  "productName": "DeckTap",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "build": "npm run build:web && npm run typecheck:desktop",
    "build:web": "npm --prefix decktap-web run build",
    "lint": "npm --prefix decktap-web run lint && npm run typecheck:desktop",
    "make": "npm run build:web && electron-forge make",
    "package": "npm run build:web && electron-forge package",
    "start": "npm run build:web && electron-forge start",
    "start:cli": "node client/lan.js",
    "typecheck:desktop": "tsc -p desktop/tsconfig.json --noEmit",
    "test": "node --test",
    "verify:prepack": "npm test && npm run lint && npm run build && node scripts/verify-prepack.js",
    "verify:package": "node scripts/verify-packaged-app.js"
  },
  "dependencies": {
    "@jitsi/robotjs": "0.6.24",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^43.3.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.3"
  }
}
